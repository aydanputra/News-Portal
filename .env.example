## Production / VPS environment example
## Salin file ini menjadi `.env` di server VPS Anda.

# PostgreSQL lokal/remote di VPS
DATABASE_URL="postgresql://news_portal_user:strong_password@127.0.0.1:5432/news_portal_db"
DIRECT_URL="postgresql://news_portal_user:strong_password@127.0.0.1:5432/news_portal_db"

# Domain publik website
NEXT_PUBLIC_SITE_URL="https://domain-anda.com"

# JWT dan secret aplikasi
JWT_SECRET="ganti_dengan_secret_panjang_acak"
MASTER_KEY="ganti_dengan_master_key_panjang_acak"
CRON_SECRET="ganti_dengan_cron_secret_panjang_acak"

# Storage: pakai local filesystem di VPS
STORAGE_PROVIDER="local"

# Jangan isi variabel S3 bila deploy ke VPS dengan storage lokal.
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ENDPOINT=""
# S3_PUBLIC_URL=""

# Telegram Notification (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# CMS version/update banner
APP_VERSION="v0.1.0"
UPDATE_CHANNEL="stable"
LATEST_VERSION_OVERRIDE=""
LATEST_CHANGELOG_URL_OVERRIDE=""
LATEST_RELEASED_AT_OVERRIDE=""

# Tools allowlist
TOOLS_ENABLED="all"
ALLOWLIST_ON_LOCALHOST="0"

# PM2 / Next.js runtime
PORT="3000"
NEXT_DIST_DIR=".next"
PM2_INSTANCES="1"
